# Prefixo da API como o NAVEGADOR enxerga (mesma origem, via proxy reverso).
# Só mude se o proxy publicar a API em outro caminho.
NEXT_PUBLIC_API_BASE=/api

# Endereço da API visto pelo servidor do Next (repasse de /api/*). Padrão:
# http://localhost:8000, a API do docker compose do api-financeiro.
# API_URL=http://localhost:8000
